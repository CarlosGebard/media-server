{% set certificate = '/etc/nginx/private-tls/fullchain.pem' %}
{% set private_key = '/etc/nginx/private-tls/privkey.pem' %}
{% macro tls() -%}
  ssl_certificate {{ certificate }};
  ssl_certificate_key {{ private_key }};
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 10m;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
{%- endmacro %}
server {
  listen 443 ssl default_server;
  server_name {{ media_private_immich_domain }};
  {{ tls() }}
  location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }
  location / { resolver 127.0.0.11 valid=10s ipv6=off; set $upstream immich-server:2283; proxy_pass http://$upstream; }
}

server {
  listen 443 ssl;
  server_name {{ media_private_couchdb_domain }};
  {{ tls() }}
  location / { resolver 127.0.0.11 valid=10s ipv6=off; set $upstream couchdb:5984; proxy_pass http://$upstream; proxy_redirect off; proxy_buffering off; }
}

server {
  listen 443 ssl;
  server_name {{ media_private_nextcloud_domain }};
  {{ tls() }}
  client_max_body_size 0;
  add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
  location = /.well-known/carddav { return 301 /remote.php/dav; }
  location = /.well-known/caldav { return 301 /remote.php/dav; }
  location / {
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $upstream nextcloud:80;
    proxy_pass http://$upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 3600s;
  }
}

server {
  listen 443 ssl;
  server_name {{ media_private_bitwarden_domain }};
  {{ tls() }}
  location / {
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $upstream bitwarden:8080;
    proxy_pass http://$upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}
